-- Mini GUI Auto Collect (Draggable + Toggle)

local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")

local collecting = false

local keywords = {"cash","Cash","money","coin","gold","collect","reward"}

local function isMoney(obj)
    for _, k in pairs(keywords) do
        if string.find(string.lower(obj.Name), k) then
            return true
        end
    end
    return false
end

-- GUI
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "MiniCollectGUI"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 180, 0, 100)
frame.Position = UDim2.new(0.5, -90, 0.5, -50)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 25)
title.Text = "Mini Auto Farm"
title.BackgroundColor3 = Color3.fromRGB(40,40,40)
title.TextColor3 = Color3.new(1,1,1)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(0.8, 0, 0, 35)
toggle.Position = UDim2.new(0.1, 0, 0.4, 0)
toggle.Text = "OFF"
toggle.BackgroundColor3 = Color3.fromRGB(120,0,0)
toggle.TextColor3 = Color3.new(1,1,1)

-- Toggle logic
toggle.MouseButton1Click:Connect(function()
    collecting = not collecting
    if collecting then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(0,120,0)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(120,0,0)
    end
end)

-- Loop collect
task.spawn(function()
    while true do
        if collecting then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and isMoney(obj) then
                    pcall(function()
                        firetouchinterest(root, obj, 0)
                        firetouchinterest(root, obj, 1)
                    end)
                end
            end
        end
        task.wait(0.5)
    end
end)
