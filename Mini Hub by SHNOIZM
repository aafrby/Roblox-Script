-- SUPER SAFE MINI HUB

local player = game.Players.LocalPlayer
repeat task.wait() until player:FindFirstChild("PlayerGui")

-- hapus GUI lama
pcall(function()
    player.PlayerGui:FindFirstChild("SafeHub"):Destroy()
end)

-- state
local autoCollect = false
local autoUpgrade = false
local speedEnabled = false

local walkSpeed = 50
local normalSpeed = 16

local moneyKeys = {"cash","money","coin","gold"}
local upgradeKeys = {"upgrade","level","brainrot"}

-- function
local function isMatch(name, list)
    name = string.lower(name)
    for _, k in pairs(list) do
        if string.find(name, k) then
            return true
        end
    end
    return false
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SafeHub"
gui.ResetOnSpawn = false
gui.Parent = player.PlayerGui

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,180,0,120)
frame.Position = UDim2.new(0,100,0,100)
frame.BackgroundColor3 = Color3.fromRGB(20,20,20)

-- drag manual
local UIS = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

local function makeBtn(txt, y)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0.8,0,0,25)
    b.Position = UDim2.new(0.1,0,y,0)
    b.Text = txt.." OFF"
    b.BackgroundColor3 = Color3.fromRGB(100,0,0)
    b.TextColor3 = Color3.new(1,1,1)
    return b
end

local collectBtn = makeBtn("Collect", 0.1)
local upgradeBtn = makeBtn("Upgrade", 0.4)
local speedBtn = makeBtn("Speed", 0.7)

local function toggle(btn, state)
    if state then
        btn.Text = btn.Text:gsub("OFF","ON")
        btn.BackgroundColor3 = Color3.fromRGB(0,120,0)
    else
        btn.Text = btn.Text:gsub("ON","OFF")
        btn.BackgroundColor3 = Color3.fromRGB(100,0,0)
    end
end

collectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    toggle(collectBtn, autoCollect)
end)

upgradeBtn.MouseButton1Click:Connect(function()
    autoUpgrade = not autoUpgrade
    toggle(upgradeBtn, autoUpgrade)
end)

speedBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    toggle(speedBtn, speedEnabled)
end)

-- auto collect
task.spawn(function()
    while true do
        if autoCollect then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and isMatch(obj.Name, moneyKeys) then
                            firetouchinterest(root, obj, 0)
                            firetouchinterest(root, obj, 1)
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

-- auto upgrade
task.spawn(function()
    while true do
        if autoUpgrade then
            for _, obj in pairs(workspace:GetDescendants()) do
                if isMatch(obj.Name, upgradeKeys) then
                    local cd = obj:FindFirstChildOfClass("ClickDetector")
                    if cd then fireclickdetector(cd) end

                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) end
                end
            end
        end
        task.wait(1)
    end
end)

-- speed
game:GetService("RunService").Heartbeat:Connect(function()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = speedEnabled and walkSpeed or normalSpeed
        end
    end
end)
