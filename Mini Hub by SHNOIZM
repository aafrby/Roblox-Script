-- BASIC STABLE HUB (GUI sederhana tapi jalan)

local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()

-- state
local autoCollect = false
local autoUpgrade = false
local speedEnabled = false

local walkSpeed = 50
local normalSpeed = 16

local moneyKeys = {"cash","money","coin","gold"}
local upgradeKeys = {"upgrade","level","brainrot"}

-- function
local function isMatch(name, list)
    name = string.lower(name)
    for _, k in pairs(list) do
        if string.find(name, k) then
            return true
        end
    end
    return false
end

-- GUI (versi lama yang stabil)
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "BasicHub"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 160, 0, 120)
frame.Position = UDim2.new(0, 20, 0, 200)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)

local function makeBtn(text, y)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.Text = text.." OFF"
    btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    btn.TextColor3 = Color3.new(1,1,1)
    return btn
end

local collectBtn = makeBtn("Collect", 5)
local upgradeBtn = makeBtn("Upgrade", 40)
local speedBtn = makeBtn("Speed", 75)

local function toggle(btn, state)
    if state then
        btn.Text = btn.Text:gsub("OFF","ON")
        btn.BackgroundColor3 = Color3.fromRGB(0,120,0)
    else
        btn.Text = btn.Text:gsub("ON","OFF")
        btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    end
end

collectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    toggle(collectBtn, autoCollect)
end)

upgradeBtn.MouseButton1Click:Connect(function()
    autoUpgrade = not autoUpgrade
    toggle(upgradeBtn, autoUpgrade)
end)

speedBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    toggle(speedBtn, speedEnabled)
end)

-- auto collect
task.spawn(function()
    while true do
        if autoCollect then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and isMatch(obj.Name, moneyKeys) then
                        firetouchinterest(root, obj, 0)
                        firetouchinterest(root, obj, 1)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

-- auto upgrade
task.spawn(function()
    while true do
        if autoUpgrade then
            for _, obj in pairs(workspace:GetDescendants()) do
                if isMatch(obj.Name, upgradeKeys) then
                    local cd = obj:FindFirstChildOfClass("ClickDetector")
                    if cd then fireclickdetector(cd) end

                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) end
                end
            end
        end
        task.wait(1)
    end
end)

-- speed
game:GetService("RunService").Heartbeat:Connect(function()
    if speedEnabled then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = walkSpeed
        end
    else
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = normalSpeed
        end
    end
end)
