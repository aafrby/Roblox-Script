-- FULL FIX MINI HUB (Auto Collect + Upgrade + Speed)

local player = game.Players.LocalPlayer
repeat task.wait() until player.Character

-- cleanup GUI lama
pcall(function()
    player.PlayerGui:FindFirstChild("MiniHub"):Destroy()
end)

-- state
local autoCollect = false
local autoUpgrade = false
local speedEnabled = false

local collectDelay = 0.3
local upgradeDelay = 0.5
local walkSpeed = 50
local normalSpeed = 16

-- keywords
local moneyKeys = {"cash","money","coin","gold","collect","reward"}
local upgradeKeys = {"upgrade","level","brainrot"}

-- functions
local function isMatch(name, list)
    for _, k in pairs(list) do
        if string.find(string.lower(name), k) then
            return true
        end
    end
    return false
end

local function getLevel(obj)
    local lvl = obj:FindFirstChild("Level")
        or obj:FindFirstChild("Lvl")
        or obj:FindFirstChild("level")
    if lvl and tonumber(lvl.Value) then
        return lvl.Value
    end
    return 0
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "MiniHub"
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 150)
frame.Position = UDim2.new(0.4, 0, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,25)
title.Text = "Mini Auto Hub"
title.BackgroundColor3 = Color3.fromRGB(40,40,40)
title.TextColor3 = Color3.new(1,1,1)

local function makeButton(text, posY)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0.8,0,0,25)
    btn.Position = UDim2.new(0.1,0,posY,0)
    btn.Text = text.." OFF"
    btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    btn.TextColor3 = Color3.new(1,1,1)
    return btn
end

local collectBtn = makeButton("Auto Collect", 0.25)
local upgradeBtn = makeButton("Auto Upgrade", 0.45)
local speedBtn = makeButton("Speed", 0.65)

local function toggle(btn, state)
    if state then
        btn.Text = string.gsub(btn.Text, "OFF", "ON")
        btn.BackgroundColor3 = Color3.fromRGB(0,120,0)
    else
        btn.Text = string.gsub(btn.Text, "ON", "OFF")
        btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    end
end

collectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    toggle(collectBtn, autoCollect)
end)

upgradeBtn.MouseButton1Click:Connect(function()
    autoUpgrade = not autoUpgrade
    toggle(upgradeBtn, autoUpgrade)
end)

speedBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    toggle(speedBtn, speedEnabled)
end)

-- Auto Collect
task.spawn(function()
    while true do
        if autoCollect then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and isMatch(obj.Name, moneyKeys) then
                            pcall(function()
                                firetouchinterest(root, obj, 0)
                                firetouchinterest(root, obj, 1)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(collectDelay)
    end
end)

-- Auto Upgrade
task.spawn(function()
    while true do
        if autoUpgrade then
            local upgrades = {}

            for _, obj in pairs(workspace:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart")) and isMatch(obj.Name, upgradeKeys) then
                    table.insert(upgrades, {
                        object = obj,
                        level = getLevel(obj)
                    })
                end
            end

            table.sort(upgrades, function(a,b)
                return a.level < b.level
            end)

            for _, data in ipairs(upgrades) do
                pcall(function()
                    local obj = data.object

                    local cd = obj:FindFirstChildOfClass("ClickDetector")
                    if cd then fireclickdetector(cd) end

                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) end
                end)
                task.wait(upgradeDelay)
            end
        end
        task.wait(1)
    end
end)

-- Speed
game:GetService("RunService").Heartbeat:Connect(function()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = speedEnabled and walkSpeed or normalSpeed
        end
    end
end)
